PORT=3000
HOST=0.0.0.0
APP_URL=http://100.88.239.70:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calendar
# PGUSER=postgres
# PGHOST=localhost
# PGPASSWORD=postgres
# PGDATABASE=calendar
# PGPORT=5432
# PGSSL=false

# Auth / security
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_DAYS=30
INACTIVITY_TIMEOUT_MINUTES=30
ALLOWED_EMAIL_DOMAIN=oic-ok.ac.jp

# Login protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# CORS: use * for school demo, or comma-separated origins for stricter operation
CORS_ORIGIN=*

# Mail delivery
# MAIL_MODE=mock keeps printing mail content to the server console.
# Set MAIL_MODE=smtp and fill SMTP_* to send real email.
MAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# PWA Web Push
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@oic-ok.ac.jp
NOTIFICATION_SCAN_INTERVAL_MS=60000

# Optional admin IP restriction, comma-separated
# ADMIN_IP_WHITELIST=127.0.0.1,100.88.94.84

# Admin seed script
ADMIN_EMAIL=24110012@oic-ok.ac.jp
ADMIN_PASSWORD=change_this_password
ADMIN_DISPLAY_NAME=admin

# Optional AI
# ANTHROPIC_API_KEY=
