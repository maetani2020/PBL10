PORT=3000
HOST=0.0.0.0
APP_URL=
CORS_ORIGIN=

# PostgreSQL
DATABASE_URL=
# Use these PG* values only when DATABASE_URL is empty.
# PGUSER=postgres
# PGHOST=localhost
# PGDATABASE=calendar
# PGPASSWORD=
# PGPORT=5432
# PGSSL=false

# Auth / security
JWT_SECRET=
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_DAYS=30
INACTIVITY_TIMEOUT_MINUTES=30
ALLOWED_EMAIL_DOMAIN=oic-ok.ac.jp
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# PWA Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Mail delivery
MAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Optional admin seed script
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=admin

# Google sign-in is currently disabled in the UI.
GOOGLE_CLIENT_ID=
